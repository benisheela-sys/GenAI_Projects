    {
      "parameters": {
        "jsCode": "const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nreturn $input.all().map(item => {\n  // 1. Find the raw string\n  let raw =\n    item.json.output ??\n    item.json.text ??\n    item.json.data ??\n    Object.values(item.json).find(val => typeof val === 'string');\n\n  // 2. Clean and parse the escaped JSON string\n  let parsed = item.json;\n  if (typeof raw === 'string') {\n    let cleaned = raw\n      .replace(/```json|```/g, '')\n      .replace(/\\\\\"/g, '\"')\n      .trim();\n\n    parsed = JSON.parse(cleaned);\n\n    if (typeof parsed === 'string') {\n      parsed = JSON.parse(parsed);\n    }\n  }\n\n  // 3. Validate email\n  const rawEmail = typeof parsed.Email === 'string' ? parsed.Email.trim() : '';\n  const validEmail = emailRegex.test(rawEmail) ? rawEmail : 'Invalid Email';\n\n  // 4. Clean field values\n  const cleanedData = {\n    Student_ID: parsed.Student_ID?.trim() || null,\n    Name: parsed.Name?.trim() || null,\n    Email: validEmail,\n    Phone: parsed.Phone?.toString().trim() || null,\n    Course: parsed.Course?.trim() || null,\n    Fee_Paid: Boolean(parsed.Fee_Paid),\n    City: parsed.City?.trim() || null,\n    Enrolled_Date: parsed.Enrolled_Date?.trim() || null,\n  };\n\n  return { json: cleanedData };\n});"
      },
