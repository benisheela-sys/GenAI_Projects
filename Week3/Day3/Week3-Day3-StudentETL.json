    {
      "parameters": {
        "jsCode": "const seen = new Set();\nconst allStudents = [];\n\nfor (const item of $input.all()) {\n  // Handle both direct items and an aggregated array inside 1 item (e.g., item.json.data)\n  const nestedArray = Object.values(item.json).find(val => Array.isArray(val));\n  const entries = nestedArray || [item.json];\n\n  for (const entry of entries) {\n    const rawText = typeof entry === 'string' ? entry : entry?.text;\n    if (!rawText) continue;\n\n    // Remove any accidental markdown code blocks\n    const cleaned = rawText.replace(/```json|```/gi, '').trim();\n\n    try {\n      const parsed = JSON.parse(cleaned);\n      // Normalize both single objects ({...}) and arrays ([{...}]) into an array\n      const rows = Array.isArray(parsed) ? parsed : [parsed];\n\n      for (const row of rows) {\n        const id = String(row.Student_ID || JSON.stringify(row)).trim();\n        if (seen.has(id)) continue;\n        seen.add(id);\n\n        allStudents.push(row);\n      }\n    } catch (err) {\n      continue;\n    }\n  }\n}\n\n// Output clean, beautified JSON items (ready for n8n Table/JSON view or Convert to File)\nreturn allStudents.map(student => ({ json: student }));"
      },
