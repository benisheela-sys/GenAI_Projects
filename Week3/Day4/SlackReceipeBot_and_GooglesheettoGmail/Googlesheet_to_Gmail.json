    {
      "parameters": {
        "jsCode": "const results = [];\nconst seenEmails = new Set();\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nfor (const item of $input.all()) {\n  const rowNumber = item.json.row_number;\n  const name = (item.json.Name || '').toString().trim();\n  const course = (item.json.Course || '').toString().trim();\n  const status = (item.json.Status || 'In Progress').toString().trim();\n  const recipientEmail = (item.json.Emailid || '').toString().trim();\n  const emailKey = recipientEmail.toLowerCase();\n  const emailSent = (item.json['Email Sent'] || '').toString().trim().toLowerCase();\n\n  // If already sent, remember the email (to catch later duplicates) and skip this row\n  if (emailSent === 'yes') {\n    if (emailKey) seenEmails.add(emailKey);\n    continue;\n  }\n\n  // Check validation & duplicate rules\n  let reason = '';\n  if (!recipientEmail || !emailRegex.test(recipientEmail)) {\n    reason = 'Invalid or missing email';\n  } else if (seenEmails.has(emailKey)) {\n    reason = 'Duplicate email';\n  } else if (!name || !course) {\n    reason = 'Missing Name or Course';\n  }\n\n  if (reason) {\n    results.push({\n      json: {\n        row_number: rowNumber,\n        to: recipientEmail,\n        isValid: false,\n        skipReason: reason,\n      },\n    });\n    continue;\n  }\n\n  // Mark this valid email as seen so any later row with the same email is flagged as a duplicate\n  seenEmails.add(emailKey);\n\n  const subject = `Welcome to Social Eagle : ${name}`;\n  const body = `\n  <div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden;\">\n    <div style=\"background-color: #1a73e8; color: #ffffff; padding: 20px; text-align: center;\">\n      <h2 style=\"margin: 0; font-size: 22px;\">Welcome to Social Eagle!</h2>\n    </div>\n    <div style=\"padding: 24px; color: #333333; line-height: 1.6; font-size: 15px;\">\n      <p style=\"margin-top: 0;\">Dear <strong>${name}</strong>,</p>\n      <p>We are thrilled to have you join our learning community! We are excited to guide you through this journey and help you gain hands-on experience and new skills.</p>\n      <div style=\"background-color: #f8f9fa; border-left: 4px solid #1a73e8; padding: 12px 16px; margin: 20px 0;\">\n        <p style=\"margin: 4px 0;\"><strong>Name:</strong> ${name}</p>\n        <p style=\"margin: 4px 0;\"><strong>Course:</strong> ${course}</p>\n        <p style=\"margin: 4px 0;\"><strong>Current Status:</strong> ${status}</p>\n      </div>\n      <p>If you have any questions or need any support getting started, please feel free to reach out to us anytime.</p>\n      <p style=\"margin-bottom: 0;\">Warm Regards,<br><strong>Admin - Social Eagle</strong></p>\n    </div>\n  </div>`;\n\n  results.push({\n    json: {\n      row_number: rowNumber,\n      to: recipientEmail,\n      subject: subject,\n      body: body,\n      isValid: true,\n    },\n  });\n}\n\nreturn results;"
      },
